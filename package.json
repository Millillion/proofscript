{
  "name": "proofscript-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --stack-size=65500 --max-old-space-size=2048 --test --test-concurrency=1 \"packages/*/test/**/*.test.ts\"",
    "test:coverage": "node --stack-size=65500 --max-old-space-size=2048 --test --test-concurrency=1 --experimental-test-coverage \"packages/*/test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^7.0.2"
  },
  "version": "0.0.10"
}
